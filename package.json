{
	"name": "@styleeyes/gelement",
	"version": "0.0.0",
	"description": "Declarative, circuit-themed interactivity for React: wire components together with power and signals.",
	"license": "MIT",
	"author": "Aaron Clement",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/aaron-khroma/gelement.git"
	},
	"homepage": "https://github.com/aaron-khroma/gelement#readme",
	"keywords": [
		"react",
		"components",
		"declarative",
		"state",
		"accessibility"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./core": {
			"types": "./dist/core/index.d.ts",
			"default": "./dist/core/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"src",
		"!src/**/*.test.*"
	],
	"engines": {
		"node": ">=24"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "eslint . && prettier --check .",
		"format": "prettier --write .",
		"check": "npm run typecheck && npm run lint && npm run test && npm run build",
		"changeset": "changeset",
		"release": "npm run build && changeset publish",
		"prepublishOnly": "npm run build"
	},
	"peerDependencies": {
		"react": "^19.0.0"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": true
		}
	},
	"devDependencies": {
		"@changesets/changelog-github": "^1.0.1",
		"@changesets/cli": "^3.0.3",
		"@eslint/js": "^10.0.1",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-react-hooks": "^7.1.1",
		"jsdom": "^31.0.0",
		"prettier": "^3.9.10",
		"react": "^19.3.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.2",
		"vitest": "^5.1.0"
	}
}
